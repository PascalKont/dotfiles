return {
  {
    "olimorris/codecompanion.nvim",
    lazy = false,
    dependencies = {
      "nvim-lua/plenary.nvim",
      "nvim-treesitter/nvim-treesitter",
      "ravitemer/codecompanion-history.nvim",
      "ravitemer/mcphub.nvim",
      "Davidyz/VectorCode",
      "HakonHarnes/img-clip.nvim",
      "OXY2DEV/markview.nvim",
      "MeanderingProgrammer/render-markdown.nvim",
    },
    keys = {
      { "<leader>ac", "<cmd>CodeCompanionChat Toggle<cr>", desc = "AI Chat", mode = { "n", "v" } },
      { "<leader>an", "<cmd>CodeCompanionChat<cr>", desc = "AI New Chat", mode = "n" },
    
      { "<leader>ab", "<cmd>%CodeCompanionChat Add<cr>", desc = "AI Add Buffer to Chat", mode = "n" },
      { "<leader>ab", "<cmd>CodeCompanionChat Add<cr>", desc = "AI Add Selection to Chat", mode = "v" },
      { "<leader>al", "<cmd>.CodeCompanionChat Add<cr>", desc = "AI Add Current Line to Chat", mode = "n" },
    
      { "<leader>ai", "<cmd>%CodeCompanion<cr>", desc = "AI Inline Assistant (current buffer)", mode = "n" },
      { "<leader>ai", "<cmd>CodeCompanion<cr>", desc = "AI Inline Assistant (selection)", mode = "v" },
    
      { "<leader>ae", "<cmd>CodeCompanion Explain this code clearly<cr>", desc = "AI Explain Selection", mode = "v" },
      { "<leader>af", "<cmd>CodeCompanion Fix this code while preserving its behavior<cr>", desc = "AI Fix Selection", mode = "v" },
      { "<leader>at", "<cmd>CodeCompanion Generate tests for this code<cr>", desc = "AI Generate Tests", mode = "v" },
    
      { "<leader>ap", "<cmd>PasteImage<cr>", desc = "AI Paste Image", mode = "n" },
      { "<leader>aa", "<cmd>CodeCompanionActions<cr>", desc = "AI Actions", mode = { "n", "v" } },
    },
{{- if eq .hosttype "external-work" }}
    opts = {
      interactions = {
        chat = {
          adapter = "ai_gateway",
          opts = {
            completion_provider = "blink",
          },
        },
        inline = {
          adapter = "ai_gateway",
        },
      },
      adapters = {
        http = {
          opts = {
            show_presets = false,
          },
          ai_gateway = function()
            return require("codecompanion.adapters").extend("openai_compatible", {
              env = {
                url = os.getenv("AI_GATEWAY_URL"),
                api_key = os.getenv("AI_GATEWAY_TOKEN"),
                chat_url = "/v1/chat/completions",
              },
              headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer ${api_key}",
              },
              schema = {
                model = {
                  default = "gpt-5.6-sol",
                },
              },
            })
          end,
        },
      },
{{- end }}
{{- if eq .hosttype "work" }}
    opts = {
      interactions = {
        chat = {
          adapter = "claude_code",
        },
        inline = {
          adapter = "claude_code",
        },
      },
      adapters = {
        acp = {
          claude_code = function()
            return require("codecompanion.adapters").extend("claude_code", {
              -- upstream default points at "claude-agent-acp", which isn't a real package;
              -- the actual ACP bridge binary ships as "claude-code-acp" (@zed-industries/claude-code-acp)
              commands = {
                default = { "claude-code-acp" },
                yolo = { "claude-code-acp", "--yolo" },
              },
              env = { CLAUDE_CODE_OAUTH_TOKEN = os.getenv("CLAUDE_CODE_OAUTH_TOKEN") },
            })
          end,
        },
      },
{{- end }}
      extensions = {
        mcphub = {
          callback = "mcphub.extensions.codecompanion",
          opts = {
            make_vars = true,
            make_slash_commands = true,
            show_result_in_chat = true,
          },
        },
        history = {
          enabled = false,
        },
      },
    },
  },
  {
    "MeanderingProgrammer/render-markdown.nvim",
    ft = { "markdown", "codecompanion" },
  },
  {
    "OXY2DEV/markview.nvim",
    lazy = false,
    opts = {
      preview = {
        filetypes = { "markdown", "codecompanion" },
        ignore_buftypes = {},
      },
    },
  },
  {
    "HakonHarnes/img-clip.nvim",
    opts = {
      filetypes = {
        codecompanion = {
          prompt_for_file_name = false,
          template = "[Image]($FILE_PATH)",
          use_absolute_path = true,
        },
      },
    },
  },
}
